{
  "name": "Copy Links",
  "version": "1.0.0",
  "description": "buttons to click to copy LinkedIn and GitHub account links",
  "manifest_version": 3,
  "author": "Arunn Chanthirakanthan",
  "action": {
    "default_popup": "index.html",
    "default_title": "Copy Links"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ]
}
